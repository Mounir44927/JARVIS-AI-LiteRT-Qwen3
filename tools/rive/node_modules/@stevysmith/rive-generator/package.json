{
  "name": "@stevysmith/rive-generator",
  "version": "0.1.1",
  "description": "Generate .riv files programmatically with TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rive",
    "animation",
    "generator",
    "riv",
    "graphics",
    "motion"
  ],
  "author": "stevysmith",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
